{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haalarikone-fi",
  "compatibility_date": "2026-03-30",
  "main": ".open-next/worker.js",

  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/llms.txt", "/llms-full.txt", "/*.txt", "/*.md", "/*.mdx"],
  },
  "vars": {
    "NEXT_PUBLIC_DATABUDDY_CLIENT_ID": "Uu3N9TuBuUAa3wAS4pHNw",
    "DATABUDDY_WEBSITE_ID": "Uu3N9TuBuUAa3wAS4pHNw",
  },
}
