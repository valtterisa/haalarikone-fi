{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-overall-app",
  "compatibility_date": "2026-03-30",
  "main": ".open-next/worker.js",

  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
}
