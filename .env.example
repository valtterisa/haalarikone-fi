# Turso (search query logging)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Databuddy (analytics + AI crawler tracking)
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=Uu3N9TuBuUAa3wAS4pHNw

# Discord — webhook-only (no in-Discord button)
DISCORD_FEEDBACK_WEBHOOK_URL=

# Discord bot (required for in-Discord “Luo draft-PR” button, no browser redirect)
# Create at https://discord.com/developers/applications → Bot + Message Content not required
# Interactions Endpoint URL: https://haalarikone.fi/api/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_FEEDBACK_CHANNEL_ID=

# Cursor Automation webhook (optional — woken by the Discord button)
# Create at https://cursor.com/automations (webhook trigger). See scripts/cursor-feedback-automation.md
CURSOR_AUTOMATION_WEBHOOK_URL=
CURSOR_AUTOMATION_WEBHOOK_KEY=
# Comma-separated: correction | general  (default: correction)
# CURSOR_AUTOMATION_FEEDBACK_TYPES=correction

# Optional public site URL override
NEXT_PUBLIC_SITE_URL=https://haalarikone.fi
