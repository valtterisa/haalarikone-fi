# Turso (search logging + auth / claims / org profiles)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth (magic link)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=
ADMIN_ACTION_SECRET=

# Cloudflare Email Sending (production: Worker send_email binding)
# Local `next dev` prints magic links to the server terminal (no email sent).
# Optional: EMAIL_DEV_LOG=1 forces terminal logging outside development.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMAIL_FROM=Haalarikone <no-reply@haalarikone.fi>
EMAIL_DEV_LOG=

# Databuddy (analytics + AI crawler tracking)
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=Uu3N9TuBuUAa3wAS4pHNw

# Discord channel webhook for feedback + claim moderation
DISCORD_FEEDBACK_WEBHOOK_URL=

# Optional public site URL override
NEXT_PUBLIC_SITE_URL=https://haalarikone.fi
